#!/usr/bin/env bash
set -e

echo "🔍 Running pre-commit checks..."

# 1. Format check
UNFORMATTED=$(gofmt -l $(git diff --cached --name-only --diff-filter=ACM "*.go"))
if [ -n "$UNFORMATTED" ]; then
    echo "❌ Go code is not properly formatted in:"
    echo "$UNFORMATTED"
    echo "Run: gofmt -w $UNFORMATTED"
    exit 1
fi

# 2. Build test
echo "🔨 Verifying Go build..."
go build -v ./cmd/jvm > /dev/null

# 3. Unit tests
echo "🧪 Running tests..."
go test ./...

echo "✅ All pre-commit checks passed!"
